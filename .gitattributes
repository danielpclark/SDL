# Check out text files with LF line endings everywhere: tests embed text
# fixtures (testdata/*.txt) with include_str! and compare them byte for
# byte, which CRLF checkouts on Windows would break.
* text=auto eol=lf

# sdl3-image's test images and their reference log are compared byte for
# byte (ASCII PNM images included, trailing spaces and all): never convert,
# diff or merge them as text.
sdl3-image/src/testdata/** binary

# Likewise sdl3-mixer's test audio and reference log.
sdl3-mixer/src/testdata/** binary

# And sdl3-mixer-timidity's test patches, SoundFont, MIDI files,
# configuration files and reference log.
sdl3-mixer-timidity/testdata/** binary

# TiMidity's license files, kept verbatim (a blank line at the end and all).
sdl3-mixer-timidity/COPYING* -whitespace

# sdl3-mixer-mpg123's test audio and reference log, and libmpg123's license
# and authors files, kept verbatim (trailing spaces and all).
sdl3-mixer-mpg123/testdata/** binary
sdl3-mixer-mpg123/COPYING -whitespace
sdl3-mixer-mpg123/AUTHORS -whitespace

# sdl3-mixer-fluidsynth's test SoundFonts, MIDI files, cases and reference
# log, and FluidSynth's and gcem's license files, kept verbatim.
sdl3-mixer-fluidsynth/testdata/** binary
sdl3-mixer-fluidsynth/COPYING -whitespace
sdl3-mixer-fluidsynth/LICENSE.gcem -whitespace

# sdl3-mixer-gme's test rips and reference log, and the license files of
# Game_Music_Emu (CRLF line endings and all) and emu2413, kept verbatim.
sdl3-mixer-gme/testdata/** binary
sdl3-mixer-gme/COPYING -text -whitespace
sdl3-mixer-gme/COPYING.emu2413 -whitespace

# sdl3-ttf's test fonts, their license (kept verbatim, trailing spaces and
# all) and reference log.
sdl3-ttf/src/testdata/** binary

# sdl3-rtf's test documents (raw 8-bit bytes, CR-free) and reference log.
sdl3-rtf/src/testdata/** binary

# sdl3-shadercross's test shaders and their reference outputs.
sdl3-shadercross/testdata/** binary

# sdl3-ttf's test images (some with text headers ending in CRLF) are
# decoded byte for byte: never convert them.
sdl3-ttf/src/testdata/images/** binary
