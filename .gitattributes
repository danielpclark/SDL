# Check out text files with LF line endings everywhere: tests embed text
# fixtures (testdata/*.txt) with include_str! and compare them byte for
# byte, which CRLF checkouts on Windows would break.
* text=auto eol=lf

# sdl3-image's test images and their reference log are compared byte for
# byte (ASCII PNM images included, trailing spaces and all): never convert,
# diff or merge them as text.
sdl3-image/src/testdata/** binary

# Likewise sdl3-mixer's test audio and reference log.
sdl3-mixer/src/testdata/** binary

# And sdl3-mixer-timidity's test patches, SoundFont, MIDI files,
# configuration files and reference log.
sdl3-mixer-timidity/testdata/** binary

# TiMidity's license files, kept verbatim (a blank line at the end and all).
sdl3-mixer-timidity/COPYING* -whitespace
